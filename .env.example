# Database (SQLite) - relative path, works on any computer
DATABASE_URL="file:./db/custom.db"

# Google Gemini API Key for OCR feature (get yours free at https://ai.google.dev/)
# Without this, OCR returns an error asking to configure the key
GEMINI_API_KEY=""

# Optional: Microsoft OneDrive Custom credentials (defaults to preconfigured client on localhost:3000)
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""
