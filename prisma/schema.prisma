// Notabase - Digital Receipt Management System
// Prisma schema with SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts  Receipt[]
}

model Receipt {
  id              String       @id @default(cuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoiceNumber   String?
  merchantName    String
  transactionDate DateTime
  category        String?
  total           Float
  description     String?
  imageUrl        String?
  ocrText         String?
  confidence      Float        @default(0)
  status          String       @default("verified") // verified | pending | failed
  items           String?      // JSON string of items
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  uploadLogs      UploadLog[]
}

model Category {
  id        String @id @default(cuid())
  name      String @unique
  color     String @default("#2563EB")
  icon      String @default("Tag")
  createdAt DateTime @default(now())
}

model UploadLog {
  id         String   @id @default(cuid())
  receiptId  String?
  receipt    Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  status     String   @default("pending") // pending | success | failed
  provider   String   @default("local") // local | onedrive
  fileName   String?
  fileSize   Int?
  message    String?
  uploadedAt DateTime @default(now())
}

model SyncLog {
  id         String   @id @default(cuid())
  fileName   String
  status     String   @default("pending") // pending | uploading | success | failed
  progress   Int      @default(0)
  fileSize   Int?
  provider   String   @default("onedrive")
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Setting {
  id    String @id
  key   String @unique
  value String
}
